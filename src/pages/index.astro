---
import Layout from '../layouts/Layout.astro';
import ListingsApp from "../components/ListingsApp.tsx";
import {getListings} from "../lib/api";

const workerUrl = import.meta.env.PUBLIC_WORKER_URL;

export const prerender = false;

const siteUrl = Astro.site ? Astro.site.origin : "https://www.eveandroque.com";
const canonicalUrl = new URL('/listings', siteUrl).href;

const pageTitle = "Luxury Film & Event Locations | Curated Property Catalog | Eve & Roque";
const pageDescription = "Explore our curated portfolio of luxury estates, modern architectural homes, and exclusive venues for film productions, photoshoots, brand activations, and private events.";

// Schema.org Structured Data
const collectionJsonLd = {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Luxury Locations for Film, Events & Photoshoots",
    "description": pageDescription,
    "url": canonicalUrl,
    "publisher": {
        "@type": "Organization",
        "name": "Eve & Roque",
        "url": siteUrl
    }
};

const breadcrumbJsonLd = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
        {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": `${siteUrl}/`
        },
        {
            "@type": "ListItem",
            "position": 2,
            "name": "Listings",
            "item": canonicalUrl
        }
    ]
};

// SSR crawlable links fallback for Googlebot and search crawlers
let initialListings: { slug: string; name: string; city: string }[] = [];
try {
    const data = await getListings('');
    if (data && Array.isArray(data.listings)) {
        initialListings = data.listings;
    }
} catch (e) {
    // Graceful fallback if Worker is unreachable during local build
}
---

<Layout
        title={pageTitle}
        description={pageDescription}
        ogImage="/listings/listing-img.webp"
        ogType="website"
        canonicalUrl={canonicalUrl}
        jsonLd={[collectionJsonLd, breadcrumbJsonLd]}
>
    <div>
        <div class="content-area">
            <div class="listing-hero">
                <div class="hero-imgwrap">
                    <div class="hero-img-overlay"></div>
                    <img src="/listings/listing-img.webp" alt="Luxury properties and locations" class="hero-image" width="100%" height="100%"
                         fetchpriority="high" loading="eager">
                </div>
                <div class="hero-content">
                    <h1>Find Your Dream Property</h1>
                    <p>Explore a curated selection of stunning properties that cater to every taste and budget. Your
                        perfect getaway or production location awaits!</p>
                </div>
            </div>

            {/* Semantic directory links for Googlebot crawler discovery */}
            {initialListings.length > 0 && (
                <nav class="sr-only" aria-label="All Property Locations">
                    <h2>Featured Film & Event Locations</h2>
                    <ul>
                        {initialListings.map((p) => (
                            <li>
                                <a href={`/listings/${p.slug}`}>
                                    {p.name} - {p.city}
                                </a>
                            </li>
                        ))}
                    </ul>
                </nav>
            )}

            <ListingsApp client:load
                         baseApiUrl={workerUrl}
                         filtersApiUrl={`${workerUrl}/api/filters`}
            />
        </div>
    </div>
</Layout>

<style>
    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    .listing-hero {
        max-width: 85rem;
        width: 100%;
        margin: 0 auto;
        background-color: #f5f5f5;
        position: relative;
        padding-top: 12rem;
        padding-bottom: 12rem;
        border-radius: 0.25rem;
        overflow: hidden;
        margin-bottom: 2rem;

        & .hero-imgwrap {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;

            & .hero-img-overlay {
                position: absolute;
                width: 100%;
                height: 100%;
                z-index: 1;
                top: 0;
                left: 0;
                background: rgba(0, 0, 0, 0.5)
            }

            & img {
                object-fit: cover;
            }
        }

        & .hero-content {
            display: flex;
            gap: 1rem;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 0 1rem;
            max-width: 33.875rem;
            margin: 0 auto;
            width: 100%;
            position: relative;
            z-index: 1;
        }
    }

    h1 {
        font-size: 2.5rem;
        font-weight: 700;
        color: #ffffff;
    }

    p {
        color: #ffffff;
        line-height: 1.5;
    }

    .content-area {
        padding-top: 6rem;
        min-height: 100vh;
    }

    .button-primary {
        border-radius: 4px;
        background: #146ef5;
        color: #ffffff;
        box-shadow: 0px 0.5px 1px rgba(0, 0, 0, 0.25), inset 0px 29px 23px -16px rgba(255, 255, 255, 0.04), inset 0px 0.5px 0.5px rgba(255, 255, 255, 0.2);
    }

    .button-primary:hover {
        background: #2c80fd;
        color: #ffffff;
    }


    @media (max-width: 768px) {
        .listing-hero {
            padding-left: 1rem;
            padding-right: 1rem;
            padding-top: 5rem;
            padding-bottom: 5rem;
            border-radius: 0
        }

        .content-area {
            padding-top: 5rem;
        }
    }

</style>
